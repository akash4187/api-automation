<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AutomationExercise API Suite" parallel="none" verbose="2">

    <listeners>
        <listener class-name="com.api.listeners.TestListener"/>
        <listener class-name="com.api.listeners.ExtentReportListener"/>
    </listeners>

    <test name="AutomationExercise - Products API">
        <classes>
            <class name="com.api.tests.automationexercise.ProductsTests"/>
        </classes>
    </test>

    <test name="AutomationExercise - Brands API">
        <classes>
            <class name="com.api.tests.automationexercise.BrandsTests"/>
        </classes>
    </test>

    <test name="AutomationExercise - Login API">
        <classes>
            <class name="com.api.tests.automationexercise.LoginTests"/>
        </classes>
    </test>

    <test name="AutomationExercise - User Account API">
        <classes>
            <class name="com.api.tests.automationexercise.UserAccountTests"/>
        </classes>
    </test>

</suite>
